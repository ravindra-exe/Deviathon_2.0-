PORT=8787
AIRTABLE_PAT=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me
AIRTABLE_ASSESSMENTS_TABLE=Assessments
AIRTABLE_QUESTIONS_TABLE=Questions
AIRTABLE_ATTEMPTS_TABLE=Attempts
DEV_ENROLLMENT_ENABLED=false
PEARL_OTP_SECRET=replace_with_long_random_secret
# Comma-separated emails permitted to use the administrator console.
PEARL_ADMIN_EMAILS=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM=Pearl Browser <no-reply@example.com>
SMTP_SECURE=false
# Optional durable backend event-log path; defaults to backend-data/proctoring-events.jsonl.
# PEARL_AUDIT_LOG_PATH=backend-data/proctoring-events.jsonl
# Optional append-only administrator action log path; defaults to backend-data/admin-actions.jsonl.
# PEARL_ADMIN_AUDIT_LOG_PATH=backend-data/admin-actions.jsonl

# Optional server-side proctoring summaries and AI question generation.
# The API key remains backend-only. Set both values in the backend .env and restart.
PEARL_PROCTORING_LLM_API_KEY=
PEARL_PROCTORING_LLM_MODEL=

# Electron reads these non-secret live backend values:
PEARL_ASSESSMENT_BACKEND_URL=http://127.0.0.1:8787
PEARL_ASSESSMENT_ID=pearl-demo-001
# Focus loss auto-submission debounce in milliseconds (100-30000; default 1000).
PEARL_AUTO_SUBMIT_FOCUS_LOSS_MS=1000
