PORT=8787
AIRTABLE_PAT=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me
AIRTABLE_ASSESSMENTS_TABLE=Assessments
AIRTABLE_QUESTIONS_TABLE=Questions
AIRTABLE_ATTEMPTS_TABLE=Attempts
DEV_ENROLLMENT_ENABLED=false
PEARL_OTP_SECRET=replace_with_long_random_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace_me
SMTP_PASS=replace_me
SMTP_FROM=Pearl Browser <no-reply@example.com>
SMTP_SECURE=false

# Optional server-side proctoring summaries (event metadata only; no webcam frames).
# Set both values in the backend .env and restart the backend to enable.
PEARL_PROCTORING_LLM_API_KEY=
PEARL_PROCTORING_LLM_MODEL=

# Electron reads these non-secret live backend values:
PEARL_ASSESSMENT_BACKEND_URL=http://127.0.0.1:8787
PEARL_ASSESSMENT_ID=pearl-demo-001
